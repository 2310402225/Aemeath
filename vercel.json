{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "astro",
	"installCommand": "pnpm install",
	"buildCommand": "pnpm run build",
	"outputDirectory": "dist",
	"build": {
		"env": {
			"NODE_OPTIONS": "--max-old-space-size=6144"
		}
	},
	"headers": [
		{
			"source": "/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/_astro/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/pagefind/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
