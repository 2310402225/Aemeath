---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import avatar from "@/assets/images/zaichen-avatar.webp";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const principles = [
	{
		icon: "material-symbols:psychology-alt-rounded",
		title: "学习可沉淀",
		text: "记录代码、公式、复现步骤、结果和局限，让零散理解逐步长成自己的 AI 知识库。",
	},
	{
		icon: "material-symbols:deployed-code",
		title: "项目有闭环",
		text: "每个项目写清背景、目标、方案、踩坑、结果和可复用资源，不把过程写成流水账。",
	},
	{
		icon: "material-symbols:auto-stories-rounded",
		title: "风格不分裂",
		text: "以技术内容为主，也保留“载尘望星”的人文视角，让记录既有用处，也有温度。",
	},
];

const priorities = [
	{
		name: "学习记录",
		description: "第一优先级，持续积累可检索、可复现的知识。",
	},
	{
		name: "资源推荐",
		description: "独立成库，说明用途、理由、适用人群和替代方案。",
	},
	{ name: "个人项目", description: "记录完整闭环，保留可复用的工程经验。" },
	{ name: "随笔", description: "保留约一成的人文观察，不让技术占据全部表达。" },
];
---

<MainGridLayout
	title="关于"
	description="关于载尘望星与作者尘之泪"
	lang={siteConfig.lang}
>
	<div class="space-y-4">
		<section class="card-base overflow-hidden p-6 md:p-8">
			<div class="flex flex-col gap-6 sm:flex-row sm:items-center">
				<Image
					src={avatar}
					alt="尘之泪的头像"
					width={144}
					height={144}
					class="h-32 w-32 shrink-0 rounded-xl object-cover ring-1 ring-black/10 dark:ring-white/15"
				/>
				<div class="min-w-0">
					<h1 class="text-3xl font-bold text-black/85 transition dark:text-white/85">
						{siteConfig.title}
					</h1>
					<p class="mt-2 text-base leading-relaxed text-black/55 transition dark:text-white/55">
						{siteConfig.subtitle}
					</p>
					<div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-black/55 dark:text-white/55">
						<span class="inline-flex items-center gap-1.5">
							<Icon is:inline name="material-symbols:person-rounded" class="text-lg text-(--primary)" />
							尘之泪
						</span>
						<span class="inline-flex items-center gap-1.5">
							<Icon is:inline name="material-symbols:badge-rounded" class="text-lg text-(--primary)" />
							曾星宇
						</span>
						<span class="inline-flex items-center gap-1.5">
							<Icon is:inline name="material-symbols:location-on-rounded" class="text-lg text-(--primary)" />
							北京
						</span>
						<a
							href="mailto:1242354176@qq.com"
							class="inline-flex items-center gap-1.5 transition hover:text-(--primary)"
						>
							<Icon is:inline name="material-symbols:mail-rounded" class="text-lg text-(--primary)" />
							1242354176@qq.com
						</a>
						<a
							href="https://github.com/2310402225"
							target="_blank"
							rel="me noreferrer"
							class="inline-flex items-center gap-1.5 transition hover:text-(--primary)"
						>
							<Icon is:inline name="fa7-brands:github" class="text-lg text-(--primary)" />
							github.com/2310402225
						</a>
					</div>
				</div>
			</div>
		</section>

		<section class="card-base p-6 md:p-8">
			<h2 class="mb-4 text-xl font-bold text-black/80 dark:text-white/80">这里写什么</h2>
			<p class="mb-6 leading-relaxed text-black/60 dark:text-white/60">
				载尘望星是尘之泪的个人知识站点。它优先服务于长期学习和项目复盘，其次整理值得反复使用的资源，并保留少量随笔作为技术之外的人文视角。
			</p>
			<div class="grid gap-3 md:grid-cols-2">
				{priorities.map((item, index) => (
					<div class="rounded-lg border border-(--line-divider) p-4">
						<div class="mb-1 flex items-center gap-2">
							<span class="flex h-6 w-6 items-center justify-center rounded-md bg-(--btn-regular-bg) text-xs font-bold text-(--primary)">
								{index + 1}
							</span>
							<span class="font-semibold text-black/75 dark:text-white/75">{item.name}</span>
						</div>
						<p class="text-sm leading-relaxed text-black/50 dark:text-white/50">{item.description}</p>
					</div>
				))}
			</div>
		</section>

		<section class="card-base p-6 md:p-8">
			<h2 class="mb-4 text-xl font-bold text-black/80 dark:text-white/80">长期原则</h2>
			<div class="grid gap-4 md:grid-cols-3">
				{principles.map((item) => (
					<div class="rounded-lg border border-(--line-divider) p-5">
						<Icon is:inline name={item.icon} class="mb-3 text-2xl text-(--primary)" />
						<h3 class="mb-2 font-bold text-black/75 dark:text-white/75">{item.title}</h3>
						<p class="text-sm leading-relaxed text-black/50 dark:text-white/50">{item.text}</p>
					</div>
				))}
			</div>
		</section>

		<section class="card-base p-6 md:p-8">
			<h2 class="mb-3 text-xl font-bold text-black/80 dark:text-white/80">当前状态</h2>
			<p class="leading-relaxed text-black/60 dark:text-white/60">
				原有站点内容已经下线，这里从零开始。学习笔记、项目复盘和资源条目会按新的写作规范逐步补充；宁缺毋滥，不复制教程，也不为了更新频率写没有验证过的结论。
			</p>
		</section>
	</div>
</MainGridLayout>
