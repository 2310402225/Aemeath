---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="博客日志" description="载尘望星的博客建设与维护记录" hasPageHeading>
	<div class="space-y-4">
		<section class="card-base p-6 md:p-8">
			<div class="mb-4 flex items-center gap-3">
				<span class="flex h-10 w-10 items-center justify-center rounded-lg bg-(--primary) text-white">
					<Icon is:inline name="material-symbols:auto-stories-rounded" class="text-2xl" />
				</span>
				<div>
					<h1 class="text-2xl font-bold text-black/80 dark:text-white/80">博客日志</h1>
					<p class="text-sm text-black/45 dark:text-white/45">记录站点本身的建设、调整与维护</p>
				</div>
			</div>
			<p class="leading-relaxed text-black/60 dark:text-white/60">
				这里暂时没有公开记录。后续只保留与站点结构、写作流程和维护方式有关的真实变更，不转载旧站公告，也不把普通内容更新混进来。
			</p>
		</section>

		<section class="card-base p-6 md:p-8">
			<h2 class="mb-3 text-lg font-bold text-black/80 dark:text-white/80">记录规范</h2>
			<ul class="space-y-2 text-sm leading-relaxed text-black/55 dark:text-white/55">
				<li class="flex gap-2"><span class="text-(--primary)">01</span><span>写清变更目的和影响范围。</span></li>
				<li class="flex gap-2"><span class="text-(--primary)">02</span><span>只记录已经完成并验证的调整。</span></li>
				<li class="flex gap-2"><span class="text-(--primary)">03</span><span>保留必要的回滚思路与后续计划。</span></li>
			</ul>
		</section>
	</div>
</MainGridLayout>
