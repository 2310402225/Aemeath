---
import { Icon } from "astro-icon/components";
import PostCard from "@/components/layout/PostCard.astro";
import { tools } from "@/data/tools";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";

const toolPosts = (await getSortedPosts()).filter(
	(post) => post.data.topic === "工具推荐",
);
---

<MainGridLayout title="工具" description="载尘望星自用或维护的轻量工具" hasPageHeading>
	<div class="space-y-4">
		<section class="card-base p-6 md:p-8">
			<div class="flex items-start gap-4">
				<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-(--primary) text-white">
					<Icon is:inline name="material-symbols:construction-rounded" class="text-2xl" />
				</span>
				<div>
					<h1 class="text-2xl font-bold text-black/80 dark:text-white/80">工具</h1>
					<p class="mt-1 max-w-3xl leading-relaxed text-black/55 dark:text-white/55">
						这里只放自己维护或长期使用的轻量工具。每个工具都应当解决明确问题，不加入自动播放、无关外链或无法解释来源的插件。
					</p>
				</div>
			</div>
		</section>

		{toolPosts.length > 0 && (
			<section class="post-card-grid grid-mode grid gap-4 md:grid-cols-2" aria-label="工具推荐文章">
				{toolPosts.map((post, index) => (
					<PostCard
						entry={post}
						title={post.data.title}
						tags={post.data.tags}
						category={post.data.category}
						published={post.data.published}
						updated={post.data.updated}
						url={getPostUrlBySlug(post.id)}
						image={post.data.image}
						description={post.data.description}
						draft={post.data.draft}
						pinned={post.data.pinned}
						password={!!post.data.password}
						loading={index < 2 ? "eager" : "lazy"}
						class="onload-animation"
						style={`animation-delay: ${index * 50}ms;`}
					/>
				))}
			</section>
		)}

		{tools.length > 0 ? (
			<section class="grid gap-4 md:grid-cols-2" aria-label="工具列表">
				{tools.map((tool) => (
					<a
						href={tool.url}
						target="_blank"
						rel="noopener noreferrer"
						class="card-base group flex flex-col p-5 transition hover:-translate-y-0.5 hover:text-(--primary)"
					>
						<div class="flex items-center justify-between gap-3">
							<h2 class="text-lg font-bold text-black/80 dark:text-white/80">{tool.name}</h2>
							<Icon is:inline name="material-symbols:arrow-outward-rounded" class="text-xl text-(--primary)" />
						</div>
						<p class="mt-2 text-sm leading-relaxed text-black/50 dark:text-white/50">{tool.description}</p>
						<div class="mt-4 flex flex-wrap gap-2">
							{tool.tags.map((tag) => (
								<span class="rounded-full bg-(--btn-regular-bg) px-2.5 py-1 text-xs text-black/55 dark:text-white/55">{tag}</span>
							))}
						</div>
					</a>
				))}
			</section>
		) : (
			toolPosts.length === 0 && (
				<section class="card-base p-10 text-center">
					<Icon is:inline name="material-symbols:construction-rounded" class="mb-4 text-5xl text-(--primary) opacity-60" />
					<h2 class="text-lg font-bold text-black/75 dark:text-white/75">暂时没有公开工具</h2>
					<p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-black/50 dark:text-white/50">
						页面结构已经保留，等工具有稳定用途和说明后再逐个补充。
					</p>
				</section>
			)
		)}
	</div>
</MainGridLayout>
