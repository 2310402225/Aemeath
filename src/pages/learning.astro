---
import { Icon } from "astro-icon/components";
import PostCard from "@/components/layout/PostCard.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";

const learningPosts = (await getSortedPosts()).filter(
	(post) => post.data.topic === "学习记录",
);
---

<MainGridLayout title="学习记录" description="载尘望星的学习笔记、代码、公式与复现步骤" hasPageHeading>
	<div class="space-y-4">
		<section class="card-base p-6 md:p-8">
			<div class="flex items-start gap-4">
				<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-(--primary) text-white">
					<Icon is:inline name="material-symbols:school" class="text-2xl" />
				</span>
				<div>
					<h1 class="text-2xl font-bold text-black/80 dark:text-white/80">学习记录</h1>
					<p class="mt-1 max-w-3xl leading-relaxed text-black/55 dark:text-white/55">
						这里优先沉淀可以复用的学习过程：代码、公式、实验条件、复现步骤、结果和尚未解决的问题。每条记录都应当能在以后被重新理解和使用。
					</p>
				</div>
			</div>
		</section>

		{learningPosts.length > 0 ? (
			<section class="post-card-grid grid-mode grid gap-4 md:grid-cols-2" aria-label="学习记录列表">
				{learningPosts.map((post, index) => (
					<PostCard
						entry={post}
						title={post.data.title}
						tags={post.data.tags}
						category={post.data.category}
						published={post.data.published}
						updated={post.data.updated}
						url={getPostUrlBySlug(post.id)}
						image={post.data.image}
						description={post.data.description}
						draft={post.data.draft}
						pinned={post.data.pinned}
						password={!!post.data.password}
						loading={index < 2 ? "eager" : "lazy"}
						class="onload-animation"
						style={`animation-delay: ${index * 50}ms;`}
					/>
				))}
			</section>
		) : (
			<section class="card-base p-10 text-center">
				<Icon is:inline name="material-symbols:menu-book-outline" class="mb-4 text-5xl text-(--primary) opacity-60" />
				<h2 class="text-lg font-bold text-black/75 dark:text-white/75">还没有学习笔记</h2>
				<p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-black/50 dark:text-white/50">
					第一篇内容会从一次真实的 AI 学习、实验或问题排查开始，不先堆满目录。
				</p>
			</section>
		)}
	</div>
</MainGridLayout>
