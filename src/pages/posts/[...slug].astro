---
import { render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import PostMetadata from "@components/layout/PostMeta.astro";
import License from "@components/misc/License.astro";
import Layout from "@layouts/Layout.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getRelatedPosts, getSortedPosts } from "@utils/content-utils";
import { getPostUrlBySlug, removeFileExtension } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

export async function getStaticPaths() {
	const posts = await getSortedPosts();

	return posts.map((entry) => ({
		params: { slug: removeFileExtension(entry.id) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const relatedPosts = await getRelatedPosts(entry, 3);

const description = entry.data.description || entry.data.title;
// 文章封面作为 OG 图（Layout 内部会补成绝对 URL）；"api" 表示随机封面 API，不适合做 OG 图
const ogImage =
	entry.data.image && entry.data.image !== "api" ? entry.data.image : undefined;
const author = entry.data.author || profileConfig.name;
const topic = entry.data.topic;
const sourceLink = entry.data.sourceLink || Astro.url.toString();
const hasNeighbor = Boolean(entry.data.prevSlug || entry.data.nextSlug);
---

{
	entry.data.fullBleed ? (
		<Layout
			title={entry.data.title}
			description={description}
			lang={siteConfig.lang}
			setOGTypeArticle
			postSlug={entry.id}
			ogImage={ogImage}
			ogImageAlt={entry.data.title}
		>
			<Content />
		</Layout>
	) : (
		<MainGridLayout
			title={entry.data.title}
			description={description}
			lang={siteConfig.lang}
			setOGTypeArticle
			postSlug={entry.id}
			ogImage={ogImage}
			ogImageAlt={entry.data.title}
			postCategory={entry.data.category || topic}
			headings={headings}
			hasPageHeading
			bannerPostMeta={{
				title: entry.data.title,
				published: entry.data.published,
				updated: entry.data.updated,
			}}
		>
	<article class="card-base px-6 py-7 md:px-10 md:py-10 mb-4">
		<header class="mb-8 border-b border-(--line-divider) pb-6">
			<div class="mb-3 flex flex-wrap items-center gap-2 text-sm text-(--primary)">
				<span class="rounded-md bg-(--btn-regular-bg) px-2.5 py-1 font-medium">
					{topic}
				</span>
				{entry.data.category && (
					<span class="text-black/45 dark:text-white/45">
						{entry.data.category}
					</span>
				)}
			</div>
			<h1 class="mb-4 text-3xl font-bold leading-tight text-black/85 transition md:text-4xl dark:text-white/85">
				{entry.data.title}
			</h1>
			{entry.data.description && (
				<p class="mb-5 text-base leading-relaxed text-black/55 transition dark:text-white/55">
					{entry.data.description}
				</p>
			)}
			<PostMetadata
				published={entry.data.published}
				updated={entry.data.updated}
				category={entry.data.category || topic}
				tags={entry.data.tags}
				id={entry.id}
				showNoTags={false}
			/>
		</header>

		<Markdown class="post-content">
			<Content />
		</Markdown>

		<div class="mt-10">
			<License
				title={`《${entry.data.title}》`}
				id={entry.id}
				pubDate={entry.data.published}
				class="rounded-xl border border-(--line-divider)"
				author={author}
				sourceLink={sourceLink}
				licenseName={entry.data.licenseName}
				licenseUrl={entry.data.licenseUrl}
			/>
		</div>
	</article>

	{relatedPosts.length > 0 && (
		<section class="card-base mb-4 p-6 md:p-8">
			<div class="mb-5 flex items-center gap-2">
				<Icon
					is:inline
					name="material-symbols:signpost-rounded"
					class="text-xl text-(--primary)"
				/>
				<h2 class="text-lg font-bold text-black/80 transition dark:text-white/80">
					相关记录
				</h2>
			</div>
			<div class="grid gap-3 md:grid-cols-3">
				{relatedPosts.map((post) => (
					<a
						href={getPostUrlBySlug(post.id)}
						class="group rounded-lg border border-(--line-divider) p-4 transition hover:border-(--primary)"
					>
						<div class="mb-2 line-clamp-2 font-medium text-black/75 transition group-hover:text-(--primary) dark:text-white/75">
							{post.data.title}
						</div>
						<div class="text-xs text-black/40 transition dark:text-white/40">
							{formatDateToYYYYMMDD(post.data.published)}
						</div>
					</a>
				))}
			</div>
		</section>
	)}

	{hasNeighbor && (
		<nav class="grid gap-3 md:grid-cols-2" aria-label="相邻文章">
			{entry.data.prevSlug ? (
				<a
					href={getPostUrlBySlug(entry.data.prevSlug)}
					class="card-base group p-5 transition hover:border-(--primary)"
				>
					<div class="mb-1 text-xs text-black/40 transition dark:text-white/40">
						上一篇
					</div>
					<div class="font-medium text-black/75 transition group-hover:text-(--primary) dark:text-white/75">
						{entry.data.prevTitle}
					</div>
				</a>
			) : (
				<div></div>
			)}
			{entry.data.nextSlug && (
				<a
					href={getPostUrlBySlug(entry.data.nextSlug)}
					class="card-base group p-5 text-right transition hover:border-(--primary)"
				>
					<div class="mb-1 text-xs text-black/40 transition dark:text-white/40">
						下一篇
					</div>
					<div class="font-medium text-black/75 transition group-hover:text-(--primary) dark:text-white/75">
						{entry.data.nextTitle}
					</div>
				</a>
			)}
		</nav>
	)}
		</MainGridLayout>
	)
}

<style is:global>
	.post-content {
		line-height: 1.85;
	}

	.post-content :where(h2, h3) {
		scroll-margin-top: 6rem;
	}

	.post-content :where(pre) {
		max-width: 100%;
	}
</style>
