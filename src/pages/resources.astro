---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { resources } from "@/data/resources";
---

<MainGridLayout title="资源推荐" description="载尘望星整理的工具、课程、论文、书单与数据集">
	<div class="space-y-4">
		<section class="card-base p-6 md:p-8">
			<div class="flex items-start gap-4">
				<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-(--primary) text-white">
					<Icon is:inline name="material-symbols:bookmark-manager" class="text-2xl" />
				</span>
				<div>
					<h1 class="text-2xl font-bold text-black/80 dark:text-white/80">资源推荐</h1>
					<p class="mt-1 max-w-3xl leading-relaxed text-black/55 dark:text-white/55">
						只推荐自己用过、读过或验证过的资源。每条资源会说明用途、推荐理由、适用人群、替代方案和标签，并保留原始链接。
					</p>
				</div>
			</div>
		</section>

		{resources.length > 0 ? (
			<section class="grid gap-4 md:grid-cols-2" aria-label="资源推荐列表">
				{resources.map((resource) => (
					<article class="card-base flex flex-col p-5">
						<div class="flex items-start justify-between gap-3">
							<div>
								<p class="text-xs font-semibold tracking-wide text-(--primary)">{resource.category}</p>
								<h2 class="mt-1 text-lg font-bold text-black/80 dark:text-white/80">{resource.name}</h2>
							</div>
							<a
								href={resource.url}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`打开 ${resource.name}`}
								class="btn-plain inline-flex h-9 w-9 items-center justify-center rounded-lg text-(--primary)"
							>
								<Icon is:inline name="material-symbols:open-in-new-rounded" class="text-xl" />
							</a>
						</div>
						<dl class="mt-4 space-y-3 text-sm">
							<div><dt class="font-semibold text-black/65 dark:text-white/65">用途</dt><dd class="mt-0.5 text-black/50 dark:text-white/50">{resource.purpose}</dd></div>
							<div><dt class="font-semibold text-black/65 dark:text-white/65">推荐理由</dt><dd class="mt-0.5 text-black/50 dark:text-white/50">{resource.reason}</dd></div>
							<div><dt class="font-semibold text-black/65 dark:text-white/65">适用人群</dt><dd class="mt-0.5 text-black/50 dark:text-white/50">{resource.audience}</dd></div>
							<div><dt class="font-semibold text-black/65 dark:text-white/65">替代方案</dt><dd class="mt-0.5 text-black/50 dark:text-white/50">{resource.alternative}</dd></div>
						</dl>
						<div class="mt-4 flex flex-wrap gap-2">
							{resource.tags.map((tag) => (
								<span class="rounded-full bg-(--btn-regular-bg) px-2.5 py-1 text-xs text-black/55 dark:text-white/55">{tag}</span>
							))}
						</div>
					</article>
				))}
			</section>
		) : (
			<section class="card-base p-10 text-center">
				<Icon is:inline name="material-symbols:bookmark-outline-rounded" class="mb-4 text-5xl text-(--primary) opacity-60" />
				<h2 class="text-lg font-bold text-black/75 dark:text-white/75">资源库还是空的</h2>
				<p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-black/50 dark:text-white/50">
					后续会从实际学习和项目中筛选资源，不为了凑数量收录链接。
				</p>
			</section>
		)}
	</div>
</MainGridLayout>
