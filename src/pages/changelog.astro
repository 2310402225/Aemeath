---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="项目更新日志" description="载尘望星中个人项目的更新记录">
	<div class="space-y-4">
		<section class="card-base p-6 md:p-8">
			<div class="mb-4 flex items-center gap-3">
				<span class="flex h-10 w-10 items-center justify-center rounded-lg bg-(--primary) text-white">
					<Icon is:inline name="material-symbols:history-edu-rounded" class="text-2xl" />
				</span>
				<div>
					<h1 class="text-2xl font-bold text-black/80 dark:text-white/80">项目更新日志</h1>
					<p class="text-sm text-black/45 dark:text-white/45">记录个人项目的版本、变化与维护状态</p>
				</div>
			</div>
			<p class="leading-relaxed text-black/60 dark:text-white/60">
				这里暂时没有公开记录。项目开始持续维护后，再按版本记录功能变化、修复内容和已知限制。
			</p>
		</section>

		<section class="card-base p-6 md:p-8">
			<h2 class="mb-3 text-lg font-bold text-black/80 dark:text-white/80">后续记录格式</h2>
			<div class="grid gap-3 sm:grid-cols-2">
				<div class="rounded-lg border border-(--line-divider) p-4">
					<p class="font-semibold text-black/70 dark:text-white/70">版本与日期</p>
					<p class="mt-1 text-sm text-black/50 dark:text-white/50">方便定位一次调整对应的项目状态。</p>
				</div>
				<div class="rounded-lg border border-(--line-divider) p-4">
					<p class="font-semibold text-black/70 dark:text-white/70">变化与原因</p>
					<p class="mt-1 text-sm text-black/50 dark:text-white/50">说明解决了什么问题，而不只罗列改动。</p>
				</div>
				<div class="rounded-lg border border-(--line-divider) p-4">
					<p class="font-semibold text-black/70 dark:text-white/70">验证结果</p>
					<p class="mt-1 text-sm text-black/50 dark:text-white/50">只写已经复现或验证过的结果。</p>
				</div>
				<div class="rounded-lg border border-(--line-divider) p-4">
					<p class="font-semibold text-black/70 dark:text-white/70">已知限制</p>
					<p class="mt-1 text-sm text-black/50 dark:text-white/50">为后续维护留下真实边界。</p>
				</div>
			</div>
		</section>
	</div>
</MainGridLayout>
