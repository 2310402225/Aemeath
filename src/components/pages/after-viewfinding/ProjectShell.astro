---
interface Props {
	index: string;
	title: string;
	source: string;
	instruction: string;
	tone?: "cyan" | "rose" | "amber" | "mint" | "violet" | "blue";
}

const { index, title, source, instruction, tone = "cyan" } = Astro.props;

const accentMap = {
	cyan: "#72e6ff",
	rose: "#ff7ca8",
	amber: "#ffd166",
	mint: "#7cf0c4",
	violet: "#b9a7ff",
	blue: "#86a8ff",
} as const;

const accent = accentMap[tone];
---

<article class="project-shell" style={`--accent: ${accent};`}>
	<aside class="project-card" aria-label={`${title} 说明`}>
		<div class="project-meta">
			<span>{index}</span>
			<span>{source}</span>
		</div>

		<div class="character-frame" aria-hidden="true">
			<div class="scan-line"></div>
			<img
				src="/assets/images/home-truncated/character-03.webp"
				alt=""
				loading="lazy"
				decoding="async"
			/>
		</div>

		<div class="project-copy">
			<h3>{title}</h3>
			<p>{instruction}</p>
		</div>
	</aside>

	<div class="project-stage">
		<slot />
	</div>
</article>

<style>
	.project-shell {
		--scan-distance: 150px;
		display: grid;
		grid-template-columns: 1fr;
		width: 100%;
		margin: 2rem 0 2.75rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--accent) 44%, #243746);
		border-radius: 8px;
		background: #06111b;
		box-shadow:
			0 28px 80px rgb(0 0 0 / 24%),
			0 0 0 1px rgb(255 255 255 / 2%) inset;
		color: #f5fbff;
	}

	.project-shell::before {
		position: absolute;
		inset: 0;
		z-index: 0;
		background-image:
			linear-gradient(rgb(114 230 255 / 4%) 1px, transparent 1px),
			linear-gradient(90deg, rgb(114 230 255 / 4%) 1px, transparent 1px);
		background-size: 28px 28px;
		content: "";
		pointer-events: none;
	}

	.project-card,
	.project-stage {
		position: relative;
		z-index: 1;
	}

	.project-card {
		display: grid;
		min-width: 0;
		grid-template-columns: 112px minmax(0, 1fr);
		grid-template-rows: auto 1fr;
		gap: 0 0.85rem;
		padding: 0.85rem 1rem 1rem;
		border-bottom: 1px solid rgb(255 255 255 / 9%);
		background: rgb(5 17 28 / 82%);
	}

	.project-meta {
		display: flex;
		grid-column: 1 / -1;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		color: var(--accent);
		font-family: "JetBrains Mono Variable", monospace;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.project-meta span:last-child {
		overflow: hidden;
		color: #8fa8ba;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.character-frame {
		position: relative;
		grid-row: 2;
		height: 150px;
		margin: 0.7rem 0 0;
		overflow: hidden;
		border-bottom: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
	}

	.character-frame::after {
		position: absolute;
		inset: auto 0 0;
		height: 42%;
		background: linear-gradient(transparent, #06111b);
		content: "";
		pointer-events: none;
	}

	.character-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 14%;
		filter: drop-shadow(0 18px 20px rgb(0 0 0 / 38%));
	}

	.scan-line {
		position: absolute;
		z-index: 2;
		top: 0;
		right: 0;
		left: 0;
		height: 1px;
		background: var(--accent);
		box-shadow: 0 0 18px var(--accent);
		opacity: 0.7;
		animation: scan 4.8s linear infinite;
	}

	.project-copy {
		grid-row: 2;
		margin-top: auto;
		padding-top: 0.72rem;
	}

	.project-copy h3 {
		margin: 0;
		color: #f7fcff;
		font-size: 1.35rem;
		font-weight: 750;
		letter-spacing: -0.02em;
		line-height: 1.05;
	}

	.project-copy p {
		margin: 0.7rem 0 0;
		color: #a9bdcb;
		font-size: 0.82rem;
		line-height: 1.7;
	}

	.project-stage {
		display: flex;
		min-width: 0;
		min-height: 360px;
		align-items: stretch;
		padding: 0.75rem;
	}

	.project-stage :global(> *) {
		width: 100%;
	}

	@keyframes scan {
		from {
			transform: translateY(0);
		}

		to {
			transform: translateY(var(--scan-distance));
		}
	}

	@media (min-width: 1100px) {
		.project-shell {
			--scan-distance: 236px;
			position: relative;
			left: 50%;
			grid-template-columns: minmax(220px, 0.34fr) minmax(0, 0.66fr);
			width: min(980px, calc(100vw - 22rem));
			transform: translateX(-50%);
		}

		.project-card {
			display: flex;
			flex-direction: column;
			padding: 1rem;
			border-right: 1px solid rgb(255 255 255 / 9%);
			border-bottom: 0;
		}

		.project-meta {
			grid-column: auto;
		}

		.character-frame {
			grid-row: auto;
			height: 236px;
			margin: 0.75rem -0.35rem 0.2rem;
		}

		.project-copy {
			grid-row: auto;
			padding-top: 1rem;
		}

		.project-copy h3 {
			font-size: clamp(1.45rem, 3vw, 2rem);
		}

		.project-copy p {
			font-size: 0.88rem;
		}

		.project-stage {
			min-height: 390px;
			padding: 1rem;
		}
	}

	@media (max-width: 760px) {
		.project-shell {
			margin-block: 1.5rem 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scan-line {
			animation: none;
		}
	}
</style>
