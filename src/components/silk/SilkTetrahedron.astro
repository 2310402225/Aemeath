---
import { url } from "@/utils/url-utils";
// 丝缕四面体外壳：五个场景（枢纽 + A/B/C 画布 + D 壁纸）全在一个页面里，正文走 <slot />。
//
// 为什么需要这个 .astro（和月下灯市同一个理由）：fullBleed 分支绕开 MainGridLayout，
// 站点的樱花／壁纸／顶部渐变会糊在画面上，要压掉它们只能用 global 样式 ——
// 而 <style is:global> 必须用 :has(#silk-stage) 钉住作用域，否则会被打进全站 CSS 误伤别的页面。
//
// 场景切换、绘画引擎都在 ./silk-scenes.ts 里，这里只搭台子、写样式、挂载。
---

<section class="silk-stage" id="silk-stage">
	<!-- 场景层整块做一次底部遮罩：底部渐隐到透明，页面背景自然露出来，不留横贯全宽的硬接缝。
	     HUD 在遮罩外面，不跟着变淡。 -->
	<div class="silk-scene">
		<canvas id="silk-ambient" class="silk-layer" aria-hidden="true"></canvas>

		<!-- 枢纽：一整颗由发光粒子构成的正四面体 -->
		<div class="silk-hub-stage" id="silk-hub-stage">
			<canvas id="silk-hub-canvas" class="silk-layer"></canvas>
			<div class="silk-intro" id="silk-intro">
				<p class="silk-kicker">载尘望星 · 交互生成艺术</p>
				<h1 class="silk-h1">丝缕<span>四面体</span></h1>
				<p class="silk-sub">Silk-Tetrahedron</p>
				<p class="silk-hubhint">拖动旋转，看它的四个面 · 点一面进去 · 或掷右下角的骰子</p>
			</div>
		</div>

		<!-- A / B / C 画布：几何与对称完全共用，只换渲染层 -->
		<div class="silk-paint-stage" id="silk-paint-stage" hidden>
			<canvas id="silk-paint-canvas" class="silk-layer"></canvas>
			<div class="silk-hint" id="silk-hint">
				<p class="silk-hint-title">丝</p>
				<p class="silk-hint-sub">交互生成艺术</p>
				<p class="silk-hint-keys">
					<span>空格</span>从头再织
					<span>Z</span>退回一笔
				</p>
				<p class="silk-hint-line">试试别的颜色，别的对称</p>
				<p class="silk-hint-call">去吧，织奇之人，扬丝作浪者</p>
			</div>
		</div>

		<!-- D 面：整张壁纸被拆成一片光粒（WebGL）。这一面没有画笔，只有扰动 -->
		<div class="silk-wall-stage" id="silk-wall-stage" hidden>
			<canvas id="silk-wall-canvas" class="silk-layer"></canvas>
			<p class="silk-wall-hint" id="silk-wall-hint">
				你可以扰动这些光粒，但它们终将回到自己的位置。
			</p>
		</div>
	</div>

	<!-- 返回箭头（每个子场景都有，枢纽上没有） -->
	<button type="button" class="silk-back" id="silk-back" hidden aria-label="返回丝缕四面体枢纽">
		<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
			<path
				d="M15 5 L8 12 L15 19"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
	</button>

	<!-- 退回博客：fullBleed 分支绕开 MainGridLayout，站点的 Navbar 与
	     FloatingControls（含「返回首页」）整块都不渲染 —— 没有这个链接，
	     进来之后除了浏览器后退键就没有出口了。放右上角、**每个场景都在**：
	     左上角那个箭头是「上一级」（子场景 → 枢纽），两级各管各的，不抢同一个位置。
	     写成 <a> 而不是 <button>：它就是一次导航，右键新标签、中键打开都该能用；
	     swup 会自己接管这个同源链接，换成客户端过渡。 -->
	<a class="silk-home" href={url("/")} aria-label="退回博客首页">
		<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
			<path
				d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
			<path
				d="M3 10a2 2 0 0 1 .7-1.5l7-6a2 2 0 0 1 2.6 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
		<span>退回博客</span>
	</a>
	<p class="silk-title" id="silk-scene-title" hidden></p>

	<!-- 出处标注：只在三张画布上出现，底部中央 -->
	<p class="silk-credit" id="silk-credit" hidden>Recreated from the original WeaveSilk · Canvas 2D</p>

	<!-- 骰子：本身也是由粒子聚成的（每个点是一小簇圆点），和四面体同一个视觉语言 -->
	<button type="button" class="silk-dice" id="silk-dice" aria-label="掷骰子，随机进入一个面">
		<svg viewBox="0 0 64 64" width="30" height="30" aria-hidden="true">
			<g class="silk-dice-pips">
				<circle cx="20" cy="20" r="6.5" /><circle cx="20" cy="20" r="2.4" />
				<circle cx="44" cy="20" r="6.5" /><circle cx="44" cy="20" r="2.4" />
				<circle cx="20" cy="44" r="6.5" /><circle cx="20" cy="44" r="2.4" />
				<circle cx="32" cy="32" r="6.5" /><circle cx="32" cy="32" r="2.4" />
				<circle cx="44" cy="44" r="6.5" /><circle cx="44" cy="44" r="2.4" />
			</g>
		</svg>
	</button>

	<!-- 绘画工具面板：只在 A/B/C 出现 -->
	<div class="silk-panel" id="silk-panel" hidden>
		<div class="silk-palette" id="silk-palette" role="group" aria-label="颜色（把一个色块拖到另一个上可以混色）"></div>
		<label class="silk-field">
			<span class="silk-field-label">对称</span>
			<select id="silk-sym" aria-label="对称方式"></select>
		</label>
		<label class="silk-field">
			<span class="silk-field-label">份数</span>
			<input id="silk-count" type="range" aria-label="对称份数" />
		</label>
		<label class="silk-field" id="silk-glitch-row" hidden>
			<span class="silk-field-label">故障</span>
			<input id="silk-glitch" type="range" min="0" max="100" value="35" aria-label="故障偏移强度" />
		</label>
		<span class="silk-sep" aria-hidden="true"></span>
		<button type="button" class="silk-icon-btn" id="silk-erase" aria-pressed="false" aria-label="橡皮擦" title="橡皮擦">
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<path
					d="m7 21-4.3-4.3a1.9 1.9 0 0 1 0-2.7l9.4-9.4a1.9 1.9 0 0 1 2.7 0l5.6 5.6a1.9 1.9 0 0 1 0 2.7L12.5 21"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
				<path
					d="M5 11.4 14.6 21M22 21H7"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>
		<button type="button" class="silk-icon-btn" id="silk-clear" aria-label="清空画面" title="清空画面">
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<path
					d="M4 6h16M9.5 6V4.2h5V6M6.4 6l.9 13.1a1.2 1.2 0 0 0 1.2 1.1h7a1.2 1.2 0 0 0 1.2-1.1L17.6 6M10.2 10.5v6M13.8 10.5v6"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>
		<button type="button" class="silk-icon-btn" id="silk-sound" aria-pressed="true" aria-label="音效开关" title="音效开关">
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<path
					d="M4 9h3l5-4v14l-5-4H4z"
					fill="currentColor"></path>
				<path
					d="M16 8.5a5 5 0 0 1 0 7"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"></path>
			</svg>
		</button>
		<button type="button" class="silk-icon-btn" id="silk-save" aria-label="保存为 PNG" title="保存为 PNG">
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<path
					d="M12 4v11m0 0 4-4m-4 4-4-4M5 19h14"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>
	</div>

	<!-- 换场景时压一层，避免看到画面切换的瞬间 -->
	<div class="silk-fade" id="silk-fade" aria-hidden="true"></div>

	<!-- 键盘／读屏用户的入口：视觉上藏起来，但不影响上面的艺术性 -->
	<nav class="sr-only" aria-label="四面体的四个面">
		<a href="#a">A 面 · 原版 Silk 丝缕</a>
		<a href="#b">B 面 · Pixel-Silk 像素</a>
		<a href="#c">C 面 · Cyber-Silk 赛博</a>
		<a href="#d">D 面 · 归境 粒子壁纸</a>
	</nav>
</section>

<article class="silk-article">
	<div class="silk-article-inner prose prose-base dark:prose-invert max-w-none!">
		<slot />
	</div>
</article>

<script>
	import { createSilkApp, type SilkApp } from "./silk-scenes";

	// swup 做客户端导航时，本页可能是换内容进来而不是整页加载 ——
	// 模块只会执行一次，所以挂载写成幂等的，并且在内容被换掉前把上一个实例拆干净。
	let app: SilkApp | null = null;

	function boot() {
		// 挂载根传 document（不是 #silk-stage 元素 —— 见 silk-scenes.ts 顶部的说明）。
		// 这里只做一次「本页确实有这个组件」的存在性判断，顺便让 swup 换页后重挂。
		if (app || !document.getElementById("silk-stage")) return;
		app = createSilkApp(document);
	}

	function teardown() {
		app?.destroy();
		app = null;
	}

	boot();
	document.addEventListener("swup:contentReplaced", boot);
	document.addEventListener("swup:page:view", boot);
	document.addEventListener("swup:willReplaceContent", teardown);
</script>

<style is:global>
	/* 首屏是自己的深色画布，站点的樱花／壁纸／顶部渐变／欢迎条会糊在上面。
	     用 :has() 钉住作用域（页面里有 #silk-stage 时才生效），否则这份 global 样式
	     会被打进全站 CSS，在别的页面误伤。 */
	html:has(#silk-stage) #canvas_sakura,
	html:has(#silk-stage) welcome-toast,
	html:has(#silk-stage) #page-background-decoration,
	html:has(#silk-stage) .top-gradient-highlight,
	html:has(#silk-stage) #wallpaper-wrapper {
		display: none !important;
	}
</style>

<style>
	.silk-stage {
		position: relative;
		height: 100svh;
		min-height: 34rem;
		overflow: hidden;
		/* 底色必须和场景层的遮罩（下面 .silk-scene 那条）用同一条曲线渐隐到透明，
		   否则底部会露出一条硬接缝 —— 浅色场景在白页上会看到一道黑边。
		   渐隐之后露出来的是页面自己的底色，明暗主题都不用管。 */
		background: linear-gradient(to bottom, #07070d 0 90%, transparent 100%);
		/* 深底上的文字统一走这两个变量，浅色场景只改变量值 */
		--silk-fg: rgb(232 238 255 / 0.92);
		--silk-fg-dim: rgb(190 204 240 / 0.55);
		--silk-fg-faint: rgb(176 192 232 / 0.34);
		--silk-panel-bg: rgb(10 12 24 / 0.42);
		--silk-panel-line: rgb(150 176 240 / 0.16);
		color: var(--silk-fg);
	}

	.silk-stage.is-light {
		background: linear-gradient(to bottom, #fff 0 90%, transparent 100%);
		--silk-fg: rgb(28 28 34 / 0.82);
		--silk-fg-dim: rgb(52 52 64 / 0.55);
		--silk-fg-faint: rgb(60 60 72 / 0.4);
		--silk-panel-bg: rgb(255 255 255 / 0.6);
		--silk-panel-line: rgb(0 0 0 / 0.1);
	}

	/* 场景层整块渐隐到透明，页面背景（浅色主题是白）自然露出来 */
	.silk-scene {
		position: absolute;
		inset: 0;
		-webkit-mask-image: linear-gradient(to bottom, #000 0 90%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 0 90%, transparent 100%);
	}

	.silk-layer {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		/* 触摸拖拽要用来作画／旋转，不能留给页面滚动 */
		touch-action: none;
	}

	/* 枢纽底纹是背景，不能跟四面体抢戏：它是几十像素宽的加色笔画，
	   在透明画布上一帧叠一帧，很容易积成一道道横扫全屏的亮带。
	   0.34 是「看得出在流动、又不喧宾夺主」的值（0.5 会明显盖过粒子）。 */
	#silk-ambient {
		opacity: 0.34;
	}

	.silk-hub-stage,
	.silk-paint-stage,
	.silk-wall-stage {
		position: absolute;
		inset: 0;
	}

	/* 画布本身是**透明**的，底色来自这里 —— 因为 "lighter" 混合在不透明白底上
	   会把颜色一路加到白、什么都画不出来。原站也是"透明画布 + 页面白底"。 */
	.silk-paint-stage {
		background: #0a0a12;
	}

	.silk-stage.is-light .silk-paint-stage {
		background: #fff;
	}

	/* C 面的暗网格背景（spec 里的"可选"）：纯 CSS 贴一层，零 JS、撤销也擦不掉它 */
	.silk-stage[data-kind="cyber"] .silk-paint-stage {
		background-image:
			linear-gradient(rgb(120 200 255 / 0.055) 1px, transparent 1px),
			linear-gradient(90deg, rgb(120 200 255 / 0.055) 1px, transparent 1px);
		background-size: 34px 34px;
	}

	/* ---------------------------------------------------------- 枢纽文案 */

	.silk-intro {
		position: absolute;
		left: 0;
		right: 0;
		top: clamp(4.5rem, 13vh, 8.5rem);
		text-align: center;
		pointer-events: none;
	}

	.silk-kicker {
		margin: 0 0 0.85rem;
		font-size: 0.68rem;
		letter-spacing: 0.34em;
		color: var(--silk-fg-faint);
	}

	.silk-h1 {
		margin: 0;
		font-size: clamp(2rem, 5.4vw, 3.4rem);
		line-height: 1.1;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: var(--silk-fg);
		text-shadow: 0 0 40px rgb(140 176 255 / 0.18);
	}

	.silk-h1 span {
		color: var(--silk-fg-dim);
	}

	.silk-sub {
		margin: 0.7rem 0 0;
		font-size: 0.72rem;
		letter-spacing: 0.3em;
		color: var(--silk-fg-faint);
	}

	.silk-hubhint {
		margin: 1.5rem 0 0;
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		color: var(--silk-fg-faint);
	}

	/* ---------------------------------------------------------- 画布引导文字 */

	.silk-hint {
		position: absolute;
		left: 0;
		right: 0;
		top: 42%;
		transform: translateY(-50%);
		text-align: center;
		pointer-events: none;
		transition: opacity 1.4s ease;
	}

	/* 第一次拖拽作画之后就淡出，不再出现 */
	.silk-hint.is-gone {
		opacity: 0;
	}

	.silk-hint p {
		margin: 0;
		font-weight: 300;
		letter-spacing: 0.08em;
		color: var(--silk-fg-dim);
	}

	.silk-hint-title {
		font-size: clamp(2.4rem, 6vw, 3.6rem);
		letter-spacing: 0.5em !important;
		text-indent: 0.5em;
		color: var(--silk-fg) !important;
	}

	.silk-hint-sub {
		margin-top: 0.5rem !important;
		font-size: 0.86rem;
		letter-spacing: 0.24em !important;
	}

	.silk-hint-keys {
		margin-top: 2.4rem !important;
		font-size: 0.8rem;
		line-height: 2.1;
	}

	.silk-hint-keys span {
		display: inline-block;
		min-width: 3.4em;
		margin-right: 0.7em;
		padding: 0.05em 0.5em;
		border: 1px solid var(--silk-panel-line);
		border-radius: 0.35em;
		font-size: 0.9em;
		color: var(--silk-fg);
	}

	.silk-hint-line {
		margin-top: 1.8rem !important;
		font-size: 0.8rem;
	}

	.silk-hint-call {
		margin-top: 1.1rem !important;
		font-size: 0.86rem;
		letter-spacing: 0.16em !important;
		color: var(--silk-fg) !important;
	}

	/* ---------------------------------------------------------- D 面文案 */

	/* 位置必须留在遮罩还够实的地方（场景层在 90% 处才开始淡出），
	   压在 bottom:0 附近会被遮罩一起抹掉，什么都看不见。 */
	.silk-wall-hint {
		position: absolute;
		left: 50%;
		bottom: clamp(4rem, 11vh, 7rem);
		transform: translateX(-50%);
		z-index: 5;
		margin: 0;
		max-width: min(88%, 32rem);
		text-align: center;
		font-size: 0.76rem;
		font-weight: 300;
		letter-spacing: 0.16em;
		line-height: 2;
		color: var(--silk-fg-dim);
		text-shadow: 0 0 20px rgb(0 0 0 / 0.9);
		pointer-events: none;
	}

	/* ---------------------------------------------------------- 返回 / 骰子 */

	.silk-back {
		position: absolute;
		left: clamp(0.9rem, 3vw, 1.8rem);
		top: clamp(0.9rem, 3vh, 1.8rem);
		z-index: 6;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 46px;
		height: 46px;
		border: 1px solid var(--silk-panel-line);
		border-radius: 999px;
		background: var(--silk-panel-bg);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		color: var(--silk-fg);
		cursor: pointer;
		transition:
			transform 220ms ease,
			border-color 220ms ease;
	}

	.silk-back:hover {
		transform: translateX(-3px);
		border-color: rgb(150 176 240 / 0.4);
	}

	.silk-title {
		position: absolute;
		left: clamp(3.6rem, 8vw, 4.6rem);
		top: clamp(0.9rem, 3vh, 1.8rem);
		z-index: 6;
		display: flex;
		align-items: center;
		height: 46px;
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.22em;
		color: var(--silk-fg-faint);
		pointer-events: none;
	}

	/* 退回博客：右上角、每个场景都在，是整页唯一的「出去」通道。
	   视觉语言跟工具面板一致（同样的描边／底／毛玻璃），高度跟返回箭头对齐，
	   让顶部这排元素看起来是一条基线，而不是各自漂浮。 */
	.silk-home {
		position: absolute;
		right: clamp(1rem, 3.5vw, 2.2rem);
		top: clamp(0.9rem, 3vh, 1.8rem);
		z-index: 6;
		display: flex;
		align-items: center;
		gap: 0.45rem;
		height: 46px;
		padding: 0 1.05rem;
		border: 1px solid var(--silk-panel-line);
		border-radius: 999px;
		background: var(--silk-panel-bg);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		color: var(--silk-fg);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-decoration: none;
