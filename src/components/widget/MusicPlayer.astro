---
import { Icon } from "astro-icon/components";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;

// 歌单：以后加歌直接往这里追加即可，切歌按钮会循环整个列表
const playlist = [
	{
		title: "远航星的告别",
		artist: "鸣潮先约电台 · Tarokiki / Emi Evans",
		src: "/assets/audio/farewell-sailing-star.mp3",
	},
];
---

<div
	class:list={[
		"music-player-card",
		"card-base relative overflow-hidden",
		className,
	]}
	style={style}
	data-playlist={JSON.stringify(playlist)}
>
	<img
		src="/assets/images/music-player-bg.webp"
		alt=""
		aria-hidden="true"
		draggable="false"
		loading="lazy"
		class="music-player-bg absolute inset-0 w-full h-full object-cover select-none"
	/>
	<div class="music-player-overlay absolute inset-0" aria-hidden="true"></div>

	<div class="relative z-10 flex flex-col gap-2.5 p-4">
		<div class="flex items-center gap-3">
			<img
				src="/assets/images/music-player-bg.webp"
				alt="音乐封面"
				draggable="false"
				loading="lazy"
				class="music-player-disc h-12 w-12 shrink-0 rounded-full object-cover shadow-lg ring-2 ring-white/50 select-none"
			/>
			<div class="min-w-0 flex-1">
				<div class="music-player-title truncate text-sm font-bold text-white">
					{playlist[0]?.title}
				</div>
				<div class="music-player-artist truncate text-xs text-white/70">
					{playlist[0]?.artist}
				</div>
			</div>
			<button
				type="button"
				class="music-player-next flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur-sm transition hover:bg-white/30 active:scale-90"
				aria-label="切换音乐"
				title="切换音乐"
			>
				<Icon is:inline name="material-symbols:skip-next-rounded" class="text-xl" />
			</button>
			<button
				type="button"
				class="music-player-toggle flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/25 text-white backdrop-blur-sm transition hover:bg-white/40 active:scale-90"
				aria-label="播放音乐"
				title="播放 / 暂停"
			>
				<Icon
					is:inline
					name="material-symbols:play-arrow-rounded"
					class="music-player-icon-play text-2xl -translate-x-px"
				/>
				<Icon
					is:inline
					name="material-symbols:pause-rounded"
					class="music-player-icon-pause hidden text-2xl"
				/>
			</button>
		</div>

		<div class="flex items-center gap-2">
			<span
				class="music-player-current w-8 shrink-0 text-right text-[0.65rem] tabular-nums text-white/70"
			>0:00</span>
			<div
				class="music-player-bar relative h-1.5 flex-1 cursor-pointer overflow-hidden rounded-full bg-white/25"
				role="slider"
				aria-label="播放进度"
				aria-valuemin="0"
				aria-valuemax="100"
				aria-valuenow="0"
				tabindex="0"
			>
				<div
					class="music-player-progress absolute inset-y-0 left-0 rounded-full bg-white/90"
					style="width:0%"
				></div>
			</div>
			<span
				class="music-player-duration w-8 shrink-0 text-[0.65rem] tabular-nums text-white/70"
			>--:--</span>
		</div>
	</div>
</div>

<style>
	.music-player-bg {
		filter: blur(18px) saturate(1.1);
		transform: scale(1.2);
	}

	.music-player-overlay {
		background: linear-gradient(
			160deg,
			rgb(0 0 0 / 0.15),
			rgb(0 0 0 / 0.45)
		);
	}

	.music-player-title {
		text-shadow: 0 1px 4px rgb(0 0 0 / 0.5);
	}

	.music-player-artist {
		text-shadow: 0 1px 3px rgb(0 0 0 / 0.4);
	}

	.music-player-disc {
		animation: music-disc-spin 12s linear infinite;
		animation-play-state: paused;
	}

	.music-player-card.is-playing .music-player-disc {
		animation-play-state: running;
	}

	.music-player-card.is-playing .music-player-icon-play {
		display: none;
	}

	.music-player-card:not(.is-playing) .music-player-icon-pause {
		display: none;
	}

	@keyframes music-disc-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.music-player-disc {
			animation: none;
		}
	}
</style>

<script>
	function initMusicPlayers() {
		const cards = document.querySelectorAll<HTMLElement>(".music-player-card");
		for (const card of cards) {
			if (card.dataset.musicInitialized === "true") continue;
			card.dataset.musicInitialized = "true";

			let playlist: { title: string; artist: string; src: string }[] = [];
			try {
				playlist = JSON.parse(card.dataset.playlist || "[]");
			} catch {
				playlist = [];
			}
			if (playlist.length === 0) continue;

			const audio = new Audio();
			audio.preload = "metadata";
			let index = 0;

			const titleEl = card.querySelector<HTMLElement>(".music-player-title");
			const artistEl = card.querySelector<HTMLElement>(".music-player-artist");
			const currentEl = card.querySelector<HTMLElement>(".music-player-current");
			const durationEl = card.querySelector<HTMLElement>(
				".music-player-duration",
			);
			const progressEl = card.querySelector<HTMLElement>(
				".music-player-progress",
			);
			const barEl = card.querySelector<HTMLElement>(".music-player-bar");
			const toggleBtn = card.querySelector<HTMLButtonElement>(
				".music-player-toggle",
			);
			const nextBtn = card.querySelector<HTMLButtonElement>(".music-player-next");
			if (
				!titleEl ||
				!artistEl ||
				!currentEl ||
				!durationEl ||
				!progressEl ||
				!barEl ||
				!toggleBtn ||
				!nextBtn
			)
				continue;

			const formatTime = (seconds: number) => {
				if (!Number.isFinite(seconds) || seconds < 0) return "--:--";
				const minutes = Math.floor(seconds / 60);
				const rest = Math.floor(seconds % 60)
					.toString()
					.padStart(2, "0");
				return `${minutes}:${rest}`;
			};

			const updatePlayState = () => {
				const playing = !audio.paused;
				card.classList.toggle("is-playing", playing);
				toggleBtn.setAttribute(
					"aria-label",
					playing ? "暂停音乐" : "播放音乐",
				);
			};

			const loadTrack = (nextIndex: number) => {
				index = ((nextIndex % playlist.length) + playlist.length) % playlist.length;
				const track = playlist[index];
				if (!track) return;
				audio.src = track.src;
				titleEl.textContent = track.title;
				artistEl.textContent = track.artist;
				currentEl.textContent = "0:00";
				durationEl.textContent = "--:--";
				progressEl.style.width = "0%";
				barEl.setAttribute("aria-valuenow", "0");
			};

			const play = () => {
				audio.play().catch(() => updatePlayState());
			};

			toggleBtn.addEventListener("click", () => {
				if (audio.paused) {
					play();
				} else {
					audio.pause();
				}
			});

			nextBtn.addEventListener("click", () => {
				const wasPlaying = !audio.paused;
				loadTrack(index + 1);
				if (wasPlaying) play();
			});

			audio.addEventListener("play", updatePlayState);
			audio.addEventListener("pause", updatePlayState);
			audio.addEventListener("ended", () => {
				loadTrack(index + 1);
				play();
			});
			audio.addEventListener("loadedmetadata", () => {
				durationEl.textContent = formatTime(audio.duration);
			});
			audio.addEventListener("timeupdate", () => {
				currentEl.textContent = formatTime(audio.currentTime);
				if (Number.isFinite(audio.duration) && audio.duration > 0) {
					const ratio = (audio.currentTime / audio.duration) * 100;
					progressEl.style.width = `${ratio}%`;
					barEl.setAttribute("aria-valuenow", `${Math.round(ratio)}`);
				}
			});
			audio.addEventListener("error", () => {
				durationEl.textContent = "--:--";
			});

			barEl.addEventListener("click", (event) => {
				const rect = barEl.getBoundingClientRect();
				const ratio = Math.min(
					1,
					Math.max(0, (event.clientX - rect.left) / rect.width),
				);
				if (Number.isFinite(audio.duration) && audio.duration > 0) {
					audio.currentTime = ratio * audio.duration;
				}
			});

			loadTrack(0);
		}
	}

	initMusicPlayers();
	document.addEventListener("astro:page-load", initMusicPlayers);
	document.addEventListener("astro:after-swap", initMusicPlayers);
</script>
