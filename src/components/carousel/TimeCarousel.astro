---
import { url } from "@/utils/url-utils";
// 时间走马灯外壳：一只水墨钟里嵌着一圈走马灯，一切都在 canvas 上算，正文走 <slot />。
//
// 为什么需要这个 .astro（和丝缕四面体、月下灯市同一个理由）：fullBleed 分支绕开
// MainGridLayout，站点的樱花／壁纸／顶部渐变／欢迎条会糊在宣纸上，要压掉它们只能用
// global 样式 —— 而 <style is:global> 必须用 :has(#tc-stage) 钉住作用域，否则会被
// 打进全站 CSS 误伤别的页面。
//
// 一份时间状态、三张画布、六支模块都在 ./carousel.ts 那一侧，这里只搭台子、写样式、挂载。
---

<section class="tc-stage" id="tc-stage">
	<!-- 场景层：一张纸、一层钟、一层灯、一层字。
	     分四层不是洁癖：纸与剪影几乎不变（按需重绘），钟与灯每帧要动但要分先后
	     （灯片在钟盘之上），字写完就冻住（风干之后一帧都不用画）——
	     四者的重绘预算与叠放次序都不一样。 -->
	<div class="tc-scene">
		<canvas id="tc-paper" class="tc-layer" aria-hidden="true"></canvas>
		<canvas id="tc-main" class="tc-layer"></canvas>
		<canvas id="tc-ring" class="tc-layer"></canvas>
		<canvas id="tc-ink" class="tc-layer" aria-hidden="true"></canvas>

		<div class="tc-intro" id="tc-intro">
			<p class="tc-kicker">载尘望星 · 交互忆旧</p>
			<h1 class="tc-h1">时间走马灯</h1>
			<p class="tc-sub">水墨忆旧馆</p>
			<p class="tc-hint" id="tc-hint">
				拨动指针，让时间往回走 · 在空处点一下，写一句旧话
			</p>
		</div>

		<!-- 展开某张灯片时的落地文字。中文字是毛笔写出来的（在 canvas 上逐笔落），
		     这里只放毛笔写不了的东西：拉丁字母、数字、年代这类印刷体小字。 -->
		<div class="tc-caption" id="tc-caption" hidden aria-live="polite">
			<p class="tc-caption-note" id="tc-caption-note"></p>
			<p class="tc-caption-latin" id="tc-caption-latin"></p>
		</div>
	</div>

	<!-- 读数：现在是哪一年、收藏了几张。安安静静地待在左上角。 -->
	<p class="tc-readout" id="tc-readout">
		<span class="tc-readout-time" id="tc-readout-time">此刻</span>
		<span class="tc-readout-sep" aria-hidden="true">·</span>
		<span class="tc-readout-count" id="tc-readout-count">未收藏</span>
	</p>

	<!-- 退回博客：fullBleed 绕开 MainGridLayout，Navbar 与 FloatingControls（含「返回首页」）
	     整块都不渲染 —— 没有这个链接，进来之后除了浏览器后退键就没有出口了。
	     写成 <a> 而不是 <button>：它就是一次导航，右键新标签、中键打开都该能用；
	     swup 会自己接管这个同源链接，换成客户端过渡。 -->
	<a class="tc-home" href={url("/")} aria-label="退回博客首页">
		<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
			<path
				d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
			<path
				d="M3 10a2 2 0 0 1 .7-1.5l7-6a2 2 0 0 1 2.6 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
		<span>退回博客</span>
	</a>

	<!-- 复位：双击钟心是指针用户的近路，但触屏与键盘用户够不着，所以给一个真的按钮。
	     44px 是触达尺寸的下限（web 规范只要求 24px，那是允许更小的例外，
	     这里没有必须紧凑的理由，就按手指来）。 -->
	<button type="button" class="tc-reset" id="tc-reset" aria-label="把时间拨回此刻">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<path
				d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1M3.5 4.5V10h5.5"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
		<span>回到此刻</span>
	</button>

	<!-- 键盘与读屏用户的入口：灯环是一张 canvas，指针点不到，这里给六个真的按钮 -->
	<nav class="sr-only" id="tc-nav" aria-label="六张灯片">
		<button type="button" data-slot="0">童年 · 葫芦娃 黑猫警长</button>
		<button type="button" data-slot="1">热血 · 马里奥 魂斗罗</button>
		<button type="button" data-slot="2">网游 · 赛尔号 洛克王国</button>
		<button type="button" data-slot="3">动画 · 秦时明月 虹猫蓝兔</button>
		<button type="button" data-slot="4">掌机 · 卡带</button>
		<button type="button" data-slot="5">玩具 · 发条玩具 玻璃弹珠</button>
	</nav>

	<p class="tc-credit">宣纸、墨钟、走马灯，全部当场算出来 · Canvas 2D</p>
</section>

<article class="tc-article">
	<div class="tc-article-inner prose prose-base dark:prose-invert max-w-none!">
		<slot />
	</div>
</article>

<script>
	import { createCarouselApp, type CarouselApp } from "./carousel";

	// swup 做客户端导航时，本页可能是换内容进来而不是整页加载 ——
	// 模块只会执行一次，所以挂载写成幂等的，并且在内容被换掉前把上一个实例拆干净。
	let app: CarouselApp | null = null;

	function boot() {
		// 挂载点由组件自己从 document 里找（不吃外来的根元素）：querySelector 只搜后代
		// 不搜自己，传 #tc-stage 进去第一句就是 null。silk-scenes.ts 上吃过这个亏。
		if (app || !document.getElementById("tc-stage")) return;
		app = createCarouselApp();
	}

	function teardown() {
		app?.destroy();
		app = null;
	}

	boot();
	document.addEventListener("swup:contentReplaced", boot);
	document.addEventListener("swup:page:view", boot);
	document.addEventListener("swup:willReplaceContent", teardown);
</script>

<style is:global>
	/* 首屏是一张宣纸，站点的樱花／壁纸／顶部渐变／欢迎条会糊在上面。
	     用 :has() 钉住作用域（页面里有 #tc-stage 时才生效），否则这份 global 样式
	     会被打进全站 CSS，在别的页面误伤。
	     ⚠️ 清单里的 `.top-gradient-highlight` 必须带点：它是 class，写成类型选择器
	     永远不匹配、也不报错，只是在画面上多一层浅灰。 */
	html:has(#tc-stage) #canvas_sakura,
	html:has(#tc-stage) welcome-toast,
	html:has(#tc-stage) #page-background-decoration,
	html:has(#tc-stage) .top-gradient-highlight,
	html:has(#tc-stage) #wallpaper-wrapper {
		display: none !important;
	}

	/* 这一页自带宣纸底色，不跟站点主题走（水墨在暗色下是另一套画法，不硬凑）。
	     但页面外的部分仍是站点的底色，所以把 html 自己也刷成纸上同色，
	     否则窄屏下滚动到正文会看到纸与白底之间那条接缝。 */
	html:has(#tc-stage) {
		background: var(--tc-paper, #f5f0e6);
	}
</style>

<style>
	.tc-stage {
		position: relative;
		height: 100svh;
		min-height: 34rem;
		overflow: hidden;
		/* 宣纸：中心略亮、四角沉一点，像一张压了很久的旧纸。 */
		background:
			radial-gradient(
				118% 92% at 50% 42%,
				var(--tc-paper) 0%,
				var(--tc-paper) 52%,
				var(--tc-paper-edge) 100%
			);
		--tc-paper: #f5f0e6;
		--tc-paper-edge: #e7dfcd;
		--tc-ink: #1c1a17;
		--tc-ink-mid: #45403a;
		/* ⚠️ 这一个值是被算出来的，不是挑出来的：#716a5d 压在 #f5f0e6 上是 4.71:1，
		   刚好过正文 4.5:1 的那条线；原来的 #7b7367 只有 4.12:1 —— 在宣纸上
		   看着「柔和」，其实是没达标。改它之前先把比值算一遍。
		   （更淡的 #a8a094 只有 2.28:1，连非文字的 3:1 都不到，所以这一页里
		   不存在「更淡的正文色」这一档，要淡就靠缩小字号。） */
		--tc-ink-soft: #716a5d;
		--tc-gold: #a8823a;
		--tc-cinnabar: #9e3d32;
		/* 0.14 的边线在宣纸上几乎看不见，按钮的边界就没了；0.3 是「看得见但不抢」的那一档。 */
		--tc-line: rgb(28 26 23 / 0.3);
		--tc-panel-bg: rgb(245 240 230 / 0.72);
		color: var(--tc-ink);
	}

	.tc-scene {
		position: absolute;
		inset: 0;
		/* 纸在底部渐隐到页面底色：钟是圆的，舞台是方的，四角留白要自然收进去，
		   而不是在下方切出一条横贯全宽的硬边。 */
		-webkit-mask-image: linear-gradient(to bottom, #000 0 94%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 0 94%, transparent 100%);
	}

	.tc-layer {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		/* 拖指针、转灯环、写字都要吃掉手势，不能让页面跟着滚 */
		touch-action: none;
	}

	/* 钟与灯是这一页的主角，字是后来添上去的墨，纸在底下什么都不抢 */
	#tc-paper {
		z-index: 1;
	}

	/* 针要走灯片底下：灯是立在前头的物件，针是纸上那道指过去的方向 */
	#tc-main {
		z-index: 2;
	}

	#tc-ring {
		z-index: 3;
	}

	#tc-ink {
		z-index: 4;
		/* ⚠️ 字写完就冻住了，这一层平时不重绘；但它盖在钟上，
		   所以必须允许指针穿过去，否则下层的拨针全被挡住。 */
		pointer-events: none;
	}

	/* ---------------------------------------------------------- 首屏文案 */

	.tc-intro {
		position: absolute;
		left: 0;
		right: 0;
		/* 顶得比较紧：这一条是立轴的「天头」，钟顶就在它下面十几像素处，
		   往下挪一点就会压住 12 点那张灯片。 */
		top: clamp(1.4rem, 4vh, 2.6rem);
		z-index: 4;
		text-align: center;
		pointer-events: none;
		transition: opacity 900ms ease;
	}

	/* 第一次真正动手（拨针 / 转灯 / 落笔）之后就退场，把画面让给钟 */
	.tc-intro.is-gone {
		opacity: 0;
	}

	.tc-kicker {
		margin: 0 0 0.5rem;
		font-size: 0.6rem;
		letter-spacing: 0.36em;
		text-indent: 0.36em;
		color: var(--tc-ink-soft);
	}

	.tc-h1 {
		margin: 0;
		font-size: clamp(1.6rem, 3.6vw, 2.4rem);
		font-weight: 500;
		line-height: 1.12;
		letter-spacing: 0.3em;
		text-indent: 0.3em;
		color: var(--tc-ink);
	}

	.tc-sub {
		margin: 0.5rem 0 0;
		font-size: 0.68rem;
		letter-spacing: 0.42em;
		text-indent: 0.42em;
		color: var(--tc-ink-soft);
	}

	/* 提示收成一行：它原本是三条读法，占了四十多像素高，正好把钟顶挤掉。
	   三件事里「转灯环」是不说也看得出来的，删掉之后一句就够。 */
	.tc-hint {
		margin: 1.05rem auto 0;
		max-width: min(92%, 30rem);
		font-size: 0.68rem;
		line-height: 1.7;
		letter-spacing: 0.08em;
		color: var(--tc-ink-soft);
	}

	/* ---------------------------------------------------------- 展开灯片时的落款 */

	.tc-caption {
		position: absolute;
		left: 50%;
		bottom: clamp(3.2rem, 9vh, 5.6rem);
		z-index: 4;
		transform: translateX(-50%);
		max-width: min(86%, 30rem);
		text-align: center;
		pointer-events: none;
		/* 进场走 ease-out（元素正在到位），退场立刻 —— 但这里是同一个类切换，
		   所以用一条短过渡即可，别让落款在半透明里悬着。 */
		transition: opacity 260ms ease-out;
	}

	.tc-caption-note {
		margin: 0;
		font-size: 0.72rem;
		line-height: 1.95;
		letter-spacing: 0.1em;
		color: var(--tc-ink-mid);
	}

	/* 毛笔写不了的拉丁字母与数字走印刷体，字号小一号、颜色淡一档，
	   让它看起来是「卡带标签」而不是标题。 */
	.tc-caption-latin {
		margin: 0.45rem 0 0;
		font-family: var(--font-jetbrains-mono), ui-monospace, monospace;
		font-size: 0.6rem;
		letter-spacing: 0.24em;
		text-indent: 0.24em;
		color: var(--tc-ink-soft);
	}

	/* ---------------------------------------------------------- 读数 / 退回 / 复位 */

	.tc-readout {
		position: absolute;
		left: clamp(1rem, 3.4vw, 2.2rem);
		top: clamp(1rem, 3.4vh, 2rem);
		z-index: 6;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		color: var(--tc-ink-soft);
		pointer-events: none;
	}

	.tc-readout-time {
		color: var(--tc-ink-mid);
	}

	.tc-readout-sep {
		color: var(--tc-line);
	}

	.tc-home,
	.tc-reset {
		position: absolute;
		z-index: 6;
		display: flex;
		align-items: center;
		gap: 0.45rem;
		height: 44px;
		padding: 0 1.05rem;
		border: 1px solid var(--tc-line);
		border-radius: 999px;
		background: var(--tc-panel-bg);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		color: var(--tc-ink);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-decoration: none;
		white-space: nowrap;
		/* 220ms 只是「按下有回应」的那一档；这里没有位移很大的动作，
		   统一一条时长就够，不必给每个属性写不同曲线。 */
		transition:
			border-color 220ms ease,
			transform 220ms ease;
	}

	.tc-home {
		right: clamp(1rem, 3.4vw, 2.2rem);
		top: clamp(1rem, 3.4vh, 2rem);
	}

	.tc-reset {
		right: clamp(1rem, 3.4vw, 2.2rem);
		bottom: clamp(1rem, 3.4vh, 2rem);
		cursor: pointer;
	}

	.tc-home:hover,
	.tc-reset:hover {
		border-color: rgb(28 26 23 / 0.4);
		transform: translateY(-2px);
	}

	.tc-home svg,
	.tc-reset svg {
		opacity: 0.7;
	}

	.tc-home:focus-visible,
	.tc-reset:focus-visible {
		outline: 2px solid var(--tc-cinnabar);
		outline-offset: 3px;
	}

	.tc-credit {
		position: absolute;
		left: 50%;
		bottom: 0.7rem;
		z-index: 6;
		margin: 0;
		transform: translateX(-50%);
		font-size: 0.56rem;
		letter-spacing: 0.08em;
		/* 署名也是要读的，所以走 ink-soft 而不是 ink-faint ——
		   「淡」是靠字号小，不是靠看不见。 */
		color: var(--tc-ink-soft);
		pointer-events: none;
		white-space: nowrap;
	}

	/* ---------------------------------------------------------- 正文 */

	.tc-article {
		position: relative;
		z-index: 1;
		background: var(--tc-paper, #f5f0e6);
	}

	.tc-article-inner {
		width: min(760px, calc(100% - 2.5rem));
		margin: 0 auto;
		padding: clamp(2.4rem, 6vh, 4.4rem) 0 clamp(4rem, 10vh, 7rem);
	}

	.tc-article-inner h2 {
		margin-top: 2.6em;
	}

	.tc-article-inner h2:first-child {
		margin-top: 0;
	}

	/* ---------------------------------------------------------- 窄屏 */

	@media (max-width: 760px) {
		.tc-intro {
			top: clamp(4.4rem, 12vh, 7rem);
		}

		.tc-h1 {
			letter-spacing: 0.2em;
			text-indent: 0.2em;
		}

		.tc-readout {
			font-size: 0.66rem;
			letter-spacing: 0.1em;
		}

		.tc-home span,
		.tc-reset span {
			/* 只留图标，把顶栏让给画面 —— 但 aria-label 仍在，读屏读得到 */
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
		}

		.tc-home,
		.tc-reset {
			padding: 0;
			width: 44px;
			justify-content: center;
		}

		.tc-credit {
			display: none;
		}
	}

	/* 尊重系统的「减少动态效果」：CSS 这侧只关过渡，canvas 那侧由 JS 读同一个查询 */
	@media (prefers-reduced-motion: reduce) {
		.tc-intro,
		.tc-caption,
		.tc-home,
		.tc-reset {
			transition-duration: 1ms;
		}

		.tc-home:hover,
		.tc-reset:hover {
			transform: none;
		}
	}
</style>
