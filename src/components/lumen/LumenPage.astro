---
// LŪMEN // ÍNDEX — 全幅页面
// 结构：首屏 hero（占满视口，1:1 还原 React + Vite + Tailwind v3 设计稿）
//      + 下方「项目背景介绍」正文（可滚动）。
// 页面内所有可点击元素（4 个导航项、CTA、信息卡链接、滚动提示）都通过
// data-scroll-to 平滑滚动到对应小节。零额外依赖，动效全部是 CSS @keyframes。
// 首屏另叠一层线框水母交互层（JellyfishField）。

import JellyfishField from "./JellyfishField.astro";

// 导航项与下方正文的四节严格 1:1 对应；改文案时两边要一起改。
const navItems = [
	{ number: "01", label: "生态系统", delay: "350ms", target: "#lumen-bg" },
	{ number: "02", label: "流动性池", delay: "450ms", target: "#lumen-stack" },
	{ number: "03", label: "流明指数", delay: "550ms", target: "#lumen-design" },
	{ number: "04", label: "治理", delay: "650ms", target: "#lumen-notes" },
];

const verticalPositions = ["12.6%", "37.5%", "61.9%", "86.2%"];
const horizontalPositions = ["32.7%", "71.4%"];

// 三个 HUD 节点。sq = 方框位置，label = 标签位置（两者由 connectors 里的折线连起来）。
// blurb / impl 是「点击方框绽开后那块面板」的内容，同时也是移动端并进正文的那份文字 ——
// 同一来源渲染两处，改一处两处同步。
const nodes = [
	{
		index: "01",
		sq: { top: "27%", left: "60%" },
		sqDelay: "1500ms",
		label: { top: "11%", left: "26%" },
		labelAnim: "anim-slide-left",
		labelDelay: "1100ms",
		title: "[ 核心实体 ]",
		desc: "实时处理数据流的神经节点",
		descMax: "max-w-[160px]",
		blurb:
			"跨 12 个区域同时驻留的推理内核。每一次呼吸都是一次全量校验，不合规的数据在到达账本之前就被拦下。",
		impl: "left 60% / top 27%，80×80（lg 100×100）1px 描边，入场延迟 1500ms。",
		target: "#lumen-bg",
		targetLabel: "项目背景",
		// 面板高度上限 = 从方框往下到首屏底部还剩多少，留 28px 余量
		panelMaxH: "calc(73vh - 28px)",
	},
	{
		index: "02",
		sq: { top: "58%", left: "32%" },
		sqDelay: "1800ms",
		label: { top: "76%", left: "3%" },
		labelAnim: "anim-slide-left",
		labelDelay: "1400ms",
		title: "[ 流明洞察 ]",
		desc: "把原始输入合成为洞见的深度学习引擎",
		descMax: "max-w-[170px]",
		blurb:
			"把行情、持仓与新闻压进同一个语义空间，再抽出可比对的结构。它不预测价格，只标出与你上一次决定不同的地方。",
		impl: "标签在左下角，两段折线接到方框左上角；折点写在 connectors 数组里。",
		target: "#lumen-design",
		targetLabel: "设计要点",
		panelMaxH: "calc(42vh - 28px)",
	},
	{
		index: "03",
		sq: { top: "63%", left: "50%" },
		sqDelay: "2100ms",
		label: { top: "50%", left: "78%" },
		labelAnim: "anim-slide-right",
		labelDelay: "1700ms",
		title: "[ 连通 ]",
		desc: "分布式网络间的零延迟传输",
		descMax: "max-w-[170px]",
		blurb:
			"结算层与托管层之间不经过任何中间账本。跨区传输的承诺上限是 40 毫秒，超时即撤回，不排队。",
		impl: "三块里唯一的「线从右往左接」，标签动画因此用的是 anim-slide-right。",
		target: "#lumen-stack",
		targetLabel: "技术栈与移植路径",
		panelMaxH: "calc(37vh - 28px)",
	},
];

// 折线：每两条一组，从标签侧接到方框的**左上角**。所以方框只能朝右下生长，
// 左上角一钉住，这六条线的坐标就永远不用动。node 用于悬停/绽开时的联动高亮。
const connectors = [
	{ x1: "38%", y1: "14%", x2: "52%", y2: "14%", delay: "1200ms", node: "01" },
	{ x1: "52%", y1: "14%", x2: "60%", y2: "27%", delay: "1400ms", node: "01" },
	{ x1: "32%", y1: "58%", x2: "20%", y2: "74%", delay: "1500ms", node: "02" },
	{ x1: "20%", y1: "74%", x2: "6%", y2: "74%", delay: "1700ms", node: "02" },
	{ x1: "78%", y1: "53%", x2: "63%", y2: "53%", delay: "1800ms", node: "03" },
	{ x1: "63%", y1: "53%", x2: "50%", y2: "63%", delay: "2000ms", node: "03" },
];

const spec: { term: string; detail: string }[] = [
	{
		term: "组件",
		detail:
			"LumenPage.astro（首屏与正文）+ JellyfishField.astro（首屏水母交互层），均在 src/components/lumen/",
	},
	{ term: "原稿", detail: "React 18 + Vite + Tailwind CSS v3" },
	{
		term: "落地",
		detail: "Astro 7 + Tailwind v4 + 原生 CSS @keyframes，水母层是 canvas 2D",
	},
	{ term: "依赖", detail: "零。没有 React runtime，也没有动画库" },
	{
		term: "接入",
		detail:
			"frontmatter 里一条 fullBleed: true，文章路由就把它渲染进裸布局，而不是博客主布局",
	},
	{
		term: "边界",
		detail:
			"astro.config.mjs 的 swup ignore 登记这条路由，进出这一页走整页导航",
	},
	{
		term: "字体",
		detail:
			"设计稿的 Graphik LCG / Manrope 未随项目分发，回退到已通过 Astro Font API 加载的 Inter（--font-inter）",
	},
];
---

<div id="lumen-page">
	<section
		id="lumen-hero"
		data-menu-open="false"
		class="group relative w-full h-screen overflow-hidden bg-black text-white font-manrope"
	>
		<!-- layer 0a: gradient fallback (shows until/unless the video paints its first frame) -->
		<div class="absolute inset-0 lumen-fallback"></div>

		<!-- layer 0b: background video -->
		<video
			class="absolute inset-0 w-full h-full object-cover anim-fade-in"
			src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260813_115057_94c3699b-0fd1-4124-bcf3-3626bb8c1f77.mp4"
			autoplay
			muted
			loop
			playsinline></video>

		<!-- layer 1: 线框水母交互层（视频之上、内容层之下） -->
		<JellyfishField />

		<!-- content layer -->
		<div class="relative z-10 w-full h-full">
			<!-- ===== NAV ===== -->
			<nav class="absolute top-0 left-0 w-full flex items-center px-5 md:px-[35px] py-5 md:py-[27px]">
				<!-- left group -->
				<div class="flex items-center gap-[40px]">
					<span
						class="font-graphik text-white text-[18px] md:text-[21px] leading-[21px] whitespace-nowrap anim-fade-up"
						style={{ animationDelay: "200ms" }}
					>
						LŪMEN // ÍNDEX
					</span>
					<div class="hidden lg:flex items-center gap-[40px]">
						{
							navItems.map((item) => (
								<div class="flex items-center gap-[3px] anim-fade-up" style={{ animationDelay: item.delay }}>
									<span class="font-manrope text-[#AFDDFF]/80 text-[13px] leading-[15.6px]">
										{item.number}.
									</span>
									<button
										type="button"
										data-scroll-to={item.target}
										class="font-manrope text-white text-[13px] leading-[15.6px] cursor-pointer hover:text-[#AFDDFF] transition-colors"
									>
										{item.label}
									</button>
								</div>
							))
						}
					</div>
				</div>

				<!-- right group (desktop) -->
				<div
					class="hidden lg:flex items-center gap-[12px] ml-auto anim-slide-right"
					style={{ animationDelay: "600ms" }}
				>
					<svg
						class="w-[15px] h-[15px] text-white"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M19 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v2"></path>
						<path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7"></path>
						<path d="M21 11h-3a2 2 0 0 0 0 4h3"></path>
					</svg>
					<span class="font-manrope text-white text-[13px] leading-[15.6px]">0x71...f4e2</span>
					<span class="font-manrope text-[#AFDDFF] text-[13px] leading-[15.6px]">[ 已连接 ]</span>
					<span class="font-manrope text-white text-[13px] leading-[15.6px] ml-[20px]">身份:</span>
					<span class="bg-[#AFDDFF] rounded-[3px] px-[5px] py-[2px] text-black text-[13px] leading-[15.6px]">
						尊享会员
					</span>
				</div>

				<!-- hamburger (mobile) -->
				<button
					type="button"
					class="lg:hidden ml-auto relative w-[40px] h-[40px] flex items-center justify-center anim-fade-in"
					style={{ animationDelay: "400ms" }}
					aria-label="Toggle menu"
					data-menu-toggle
				>
					<span
						class="absolute transition-all duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] opacity-100 rotate-0 scale-100 group-data-[menu-open=true]:opacity-0 group-data-[menu-open=true]:rotate-90 group-data-[menu-open=true]:scale-50"
					>
						<svg
							class="w-[22px] h-[22px] text-white"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path>
						</svg>
					</span>
					<span
						class="absolute transition-all duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] opacity-0 -rotate-90 scale-50 group-data-[menu-open=true]:opacity-100 group-data-[menu-open=true]:rotate-0 group-data-[menu-open=true]:scale-100"
					>
						<svg
							class="w-[22px] h-[22px] text-white"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
						</svg>
					</span>
				</button>
			</nav>

			<!-- ===== MOBILE MENU OVERLAY ===== -->
			<div
				class="fixed inset-0 z-50 lg:hidden invisible opacity-0 transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] group-data-[menu-open=true]:visible group-data-[menu-open=true]:opacity-100"
				data-menu-overlay
			>
				<div
					class="absolute inset-0 bg-black/90 backdrop-blur-md opacity-0 transition-opacity duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] group-data-[menu-open=true]:opacity-100"
					data-menu-backdrop
				>
				</div>

				<div
					class="relative h-full flex flex-col px-5 pt-24 pb-10 transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] opacity-0 -translate-y-4 group-data-[menu-open=true]:opacity-100 group-data-[menu-open=true]:translate-y-0"
				>
					<button
						type="button"
						class="absolute top-5 right-5 w-[40px] h-[40px] flex items-center justify-center"
						aria-label="Close menu"
						data-menu-close
					>
						<svg
							class="w-[22px] h-[22px] text-white"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
						</svg>
					</button>

					<nav class="flex flex-col gap-8">
						{
							navItems.map((item) => (
								<button
									type="button"
									data-scroll-to={item.target}
									class="flex items-center gap-3 text-left transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] opacity-100 translate-x-0 group-data-[menu-open=false]:opacity-0 group-data-[menu-open=false]:-translate-x-6"
									style={{ transitionDelay: "150ms" }}
								>
									<span class="font-manrope text-[#AFDDFF]/80 text-[14px] leading-[1]">
										{item.number}.
									</span>
									<span class="font-manrope text-white text-[28px] leading-[1.2] tracking-tight">
										{item.label}
									</span>
								</button>
							))
						}
					</nav>

					<!-- wallet block, pinned bottom -->
					<div
						class="mt-auto pt-10 border-t border-white/10 transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] opacity-100 translate-y-0 group-data-[menu-open=false]:opacity-0 group-data-[menu-open=false]:translate-y-4"
						style={{ transitionDelay: "450ms" }}
					>
						<div class="flex items-center gap-[10px] mb-3">
							<svg
								class="w-[15px] h-[15px] text-white"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M19 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v2"></path>
								<path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7"></path>
								<path d="M21 11h-3a2 2 0 0 0 0 4h3"></path>
							</svg>
							<span class="font-manrope text-white text-[13px] leading-[15.6px]">0x71...f4e2</span>
							<span class="font-manrope text-[#AFDDFF] text-[13px] leading-[15.6px]">[ 已连接 ]</span>
						</div>
						<div class="flex items-center gap-[8px]">
							<span class="font-manrope text-white text-[13px] leading-[15.6px]">身份:</span>
							<span class="bg-[#AFDDFF] rounded-[3px] px-[5px] py-[2px] text-black text-[13px] leading-[15.6px]">
								尊享会员
							</span>
						</div>
					</div>
				</div>
			</div>

			<!-- ===== H1 ===== -->
			<h1
				class="font-graphik text-white font-normal leading-[1.12em] absolute anim-fade-up text-[32px] sm:text-[48px] md:text-[68px] top-[140px] sm:top-[160px] md:top-[178px] left-5 md:left-[35px] max-w-[300px] sm:max-w-[420px] md:max-w-[554px]"
				style={{ animationDelay: "400ms" }}
			>资产如水。<br />回报如光。</h1>

			<!-- ===== GRID LINES + PLUS MARKS ===== -->
			{
				verticalPositions.map((left, i) => (
					<div
						class="absolute top-0 h-full w-px bg-white/[0.04] anim-grid-v"
						style={{ left, animationDelay: `${600 + i * 100}ms` }}
					/>
				))
			}
			{
				horizontalPositions.map((top, i) => (
					<div
						class="absolute left-0 w-full h-px bg-white/[0.04] anim-grid-h"
						style={{ top, animationDelay: `${800 + i * 150}ms` }}
					/>
				))
			}
			{
				horizontalPositions.map((top, hi) =>
					verticalPositions.map((left, vi) => (
						<div
							class="absolute anim-scale-in"
							style={{ top, left, animationDelay: `${1000 + (hi * 4 + vi) * 80}ms` }}
						>
							<div class="absolute w-[10px] h-px bg-white/70 -translate-x-1/2 -translate-y-1/2" />
							<div class="absolute w-px h-[10px] bg-white/70 -translate-x-1/2 -translate-y-1/2" />
						</div>
					)),
				)
			}

			<!-- ===== CENTRAL NODES ===== -->
			<div class="absolute inset-0 pointer-events-none hidden md:block">
				{
					connectors.map((c) => (
						<svg
							class="absolute inset-0 w-full h-full pointer-events-none anim-fade-in"
							style={{ animationDelay: c.delay }}
						>
							<line
								class="lumen-node-line"
								data-lumen-conn={c.node}
								x1={c.x1}
								y1={c.y1}
								x2={c.x2}
								y2={c.y2}
								stroke-width="1"
								vector-effect="non-scaling-stroke"
							/>
						</svg>
					))
				}

				{
					nodes.map((n) => (
						<>
							{/* 方框：常态静止，悬停亮起，点击在它左上角长出面板 */}
							<button
								type="button"
								class="lumen-node-sq anim-scale-in absolute w-[80px] h-[80px] lg:w-[100px] lg:h-[100px] border border-white/80 bg-transparent p-0"
								data-lumen-node={n.index}
								style={{ top: n.sq.top, left: n.sq.left, animationDelay: n.sqDelay }}
								aria-expanded="false"
								aria-controls={`lumen-node-panel-${n.index}`}
								aria-label={`展开「${n.title}」的说明`}
							>
								<span class="lumen-node-cross" aria-hidden="true" />
								<span class="lumen-node-ripple" aria-hidden="true" />
								<span class="lumen-node-ripple" aria-hidden="true" />
								<span class="lumen-node-ripple" aria-hidden="true" />
							</button>

							{/* 面板：与方框同源点，朝右下生长。关着时 opacity 0 且不可点 */}
							<div
								id={`lumen-node-panel-${n.index}`}
								class="lumen-node-panel"
								data-lumen-panel={n.index}
								style={{ top: n.sq.top, left: n.sq.left, maxHeight: n.panelMaxH }}
								role="region"
								aria-label={`${n.title} 说明`}
							>
								<button
									type="button"
									class="lumen-node-panel__close"
									data-lumen-close
									aria-label="收起说明"
								>
									<span aria-hidden="true">&#215;</span>
								</button>
								<div class="lumen-node-panel__head">
									<span class="lumen-node-panel__index">{n.index}</span>
									<span class="lumen-node-panel__title">{n.title}</span>
								</div>
								<div class="lumen-node-panel__foot">
									<p class="lumen-node-panel__blurb">{n.blurb}</p>
									<p class="lumen-node-panel__impl">
										<span>实现</span>
										{n.impl}
									</p>
									<button
										type="button"
										class="lumen-node-panel__jump"
										data-scroll-to={n.target}
									>
										{n.targetLabel}
										<span aria-hidden="true">&#8594;</span>
									</button>
								</div>
							</div>

							<div
								class="lumen-node-label absolute"
								data-lumen-node={n.index}
								style={{ top: n.label.top, left: n.label.left }}
							>
								<div class={`${n.labelAnim}`} style={{ animationDelay: n.labelDelay }}>
									<span class="lumen-node-label-title font-manrope text-white text-[13px] leading-[15.6px] whitespace-nowrap">
										{n.title}
									</span>
									<p class={`font-manrope text-white/50 text-[11px] leading-[14px] mt-[4px] ${n.descMax}`}>
										{n.desc}
									</p>
								</div>
							</div>
						</>
					))
				}
			</div>

			<!-- ===== BOTTOM ROW ===== -->
			<div
				class="absolute bottom-5 md:bottom-[35px] left-5 md:left-[35px] right-5 md:right-[35px] flex flex-col md:flex-row items-start md:items-end justify-between gap-5 md:gap-0"
			>
				<!-- CTA -->
				<button
					type="button"
					data-scroll-to="#lumen-bg"
					class="bg-[#AFDDFF] px-[16px] md:px-[20px] py-[10px] md:py-[12px] flex items-center gap-[10px] cursor-pointer hover:bg-[#c8e8ff] transition-colors anim-fade-up"
					style={{ animationDelay: "900ms" }}
				>
					<span class="text-black text-[16px] leading-none">&#10022;</span>
					<span class="font-manrope text-black text-[12px] md:text-[13px] leading-[15.6px] tracking-wide">
						探索私人银行
					</span>
				</button>

				<!-- info card -->
				<div class="relative max-w-[280px] hidden sm:block anim-slide-right" style={{ animationDelay: "1100ms" }}>
					<span
						class="font-manrope text-black text-[13px] leading-[15.6px] bg-[#AFDDFF] px-[6px] py-[2px] inline-block mb-[10px]"
					>
						不是银行，是一个生态
					</span>
					<div class="relative p-[20px]">
						<svg
							class="absolute inset-0 w-full h-full pointer-events-none"
							viewBox="0 0 280 168"
							preserveAspectRatio="none"
						>
							<polygon
								points="0.5,0.5 279.5,0.5 279.5,167.5 30,167.5 0.5,137.5"
								fill="none"
								stroke="#AFDDFF"
								stroke-width="1"
