			</footer>
		</div>
	</section>
</div>

<style is:global>
	/* ---- LŪMEN // ÍNDEX 全幅页样式（本组件只在这一页渲染，所以用 global 统一管） ---- */
	/* 设计稿用的 Graphik LCG / Manrope 未随项目分发。回退到项目已通过 Astro Font API
	   加载的 Inter（--font-inter），同属中性新怪诞体，观感 1:1。若日后把 Manrope 加进
	   fontConfig，会优先生效。 */
	#lumen-page {
		background-color: #000;
	}

	#lumen-page,
	#lumen-hero,
	#lumen-article {
		font-family: "Manrope", var(--font-inter), "Inter", "Helvetica Neue", Arial, sans-serif;
	}

	#lumen-hero .font-graphik,
	#lumen-article .font-graphik {
		font-family: "Graphik LCG Regular", "Graphik LCG", var(--font-inter), "Inter", "Helvetica Neue",
			Arial, sans-serif;
	}

	#lumen-hero .font-manrope,
	#lumen-article .font-manrope {
		font-family: "Manrope", var(--font-inter), "Inter", "Helvetica Neue", Arial, sans-serif;
	}

	/* 整页黑底，避免主题浅色背景在 overscroll 时露出来。
	   用 :has() 把作用域钉在本页（页面里有 #lumen-page 时才生效），
	   防止这份 global 样式被 Astro 打进全站 CSS 后在别的页面误伤。 */
	html:has(#lumen-page),
	html:has(#lumen-page) body {
		background-color: #000;
	}

	/* 视频未加载 / 慢网络时的兜底：一块深色、带冷光晕的渐变，视觉上仍是"成品" */
	#lumen-hero .lumen-fallback {
		background:
			radial-gradient(
				120% 90% at 64% 40%,
				rgba(175, 221, 255, 0.14) 0%,
				rgba(175, 221, 255, 0.04) 40%,
				rgba(0, 0, 0, 0) 68%
			),
			radial-gradient(
				90% 70% at 28% 80%,
				rgba(110, 160, 220, 0.1) 0%,
				rgba(0, 0, 0, 0) 60%
			),
			linear-gradient(180deg, #05070c 0%, #000 62%, #000 100%);
	}

	/* 首屏底部的滚动提示 */
	#lumen-hero .lumen-scroll-line {
		display: block;
		width: 1px;
		height: 28px;
		background: linear-gradient(to bottom, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0));
	}

	/* Suppress blog-wide decorations that would sit on top of the hero.
	   同样用 :has() 限定在本页，避免影响其它页面。 */
	html:has(#lumen-page) #canvas_sakura,
	html:has(#lumen-page) welcome-toast,
	html:has(#lumen-page) #page-background-decoration,
	html:has(#lumen-page) top-gradient-highlight,
	html:has(#lumen-page) #wallpaper-wrapper {
		display: none !important;
	}

	/* ---------- HUD 节点：悬停联动 + 绽开面板 ----------
	   交互只在 lg+ 开放。md 段（768–1023）方框仍是纯装饰，和改动前一致 ——
	   因为面板宽 240px，而节点 2 的方框到节点 3 的方框只有 18vw，窄屏放不下。 */
	#lumen-hero .lumen-node-line {
		stroke: rgba(255, 255, 255, 0.25);
		transition: stroke 0.3s ease;
	}

	#lumen-hero .lumen-node-sq {
		display: block;
		/* 入场动画跑完前不可点：opacity: 0 不挡命中测试，少了这句就会「看不见却能点亮」 */
		pointer-events: none;
		transition:
			border-color 0.3s ease,
			transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	/* 悬停时框内浮现的十字准星，缓速自转 */
	#lumen-hero .lumen-node-cross {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 0.35s ease;
	}

	#lumen-hero .lumen-node-cross::before,
	#lumen-hero .lumen-node-cross::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		background: #afddff;
	}

	#lumen-hero .lumen-node-cross::before {
		width: 34px;
		height: 1px;
		margin: -0.5px 0 0 -17px;
