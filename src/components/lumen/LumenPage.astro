</style>

<script>
	const hero = document.getElementById("lumen-hero");

	if (hero) {
		const toggle = hero.querySelector("[data-menu-toggle]");
		const backdrop = hero.querySelector("[data-menu-backdrop]");
		const closeBtn = hero.querySelector("[data-menu-close]");

		// 远端视频加载失败时移除它，露出下方的渐变兜底
		const video = hero.querySelector("video");
		video?.addEventListener("error", () => video?.remove());

		const setOpen = (open: boolean) => hero.setAttribute("data-menu-open", String(open));

		toggle?.addEventListener("click", () => {
			setOpen(hero.getAttribute("data-menu-open") !== "true");
		});
		closeBtn?.addEventListener("click", () => setOpen(false));
		backdrop?.addEventListener("click", () => setOpen(false));

		// ---- HUD 节点：悬停联动 + 点击绽开 ----
		// 同时只开一个。四种关闭：再点原位（面板左上角那格就是关闭格）/ Esc /
		// 点面板外部空白 / 点另一个方框（切换）。
		// 联动高亮（方框提亮、十字准星、对应折线、标签）统一走 is-active，
		// 悬停和绽开是同一条代码路径，不写两份。
		const sqs = Array.from(hero.querySelectorAll<HTMLButtonElement>(".lumen-node-sq"));
		const labels = Array.from(hero.querySelectorAll<HTMLElement>(".lumen-node-label"));
		const lines = Array.from(hero.querySelectorAll<SVGLineElement>(".lumen-node-line"));
		const panels = Array.from(hero.querySelectorAll<HTMLElement>(".lumen-node-panel"));
		const lgQuery = window.matchMedia("(min-width: 1024px)");

		let openIndex: string | null = null;
		let hoverIndex: string | null = null;

		const indexOf = (el: Element | null) => el?.getAttribute("data-lumen-node") ?? null;
		const panelOf = (index: string) =>
			panels.find((p) => p.getAttribute("data-lumen-panel") === index) ?? null;
		const sqOf = (index: string) => sqs.find((s) => indexOf(s) === index) ?? null;

		const paint = () => {
			const active = openIndex ?? hoverIndex;
			for (const el of sqs) el.classList.toggle("is-active", indexOf(el) === active);
			for (const el of labels) el.classList.toggle("is-active", indexOf(el) === active);
			for (const el of lines) {
				el.classList.toggle(
					"is-active",
					active !== null && el.getAttribute("data-lumen-conn") === active,
				);
			}
		};

		const closePanel = (restoreFocus: boolean) => {
			if (!openIndex) return;
			const index = openIndex;
			const panel = panelOf(index);
			const sq = sqOf(index);
			openIndex = null;
			panel?.classList.remove("is-open");
			sq?.classList.remove("is-open");
			sq?.setAttribute("aria-expanded", "false");
			paint();
			if (restoreFocus) sq?.focus();
		};

		const openPanel = (index: string, fromKeyboard: boolean) => {
			if (openIndex === index) {
				closePanel(false);
				return;
			}
			closePanel(false);

			const panel = panelOf(index);
			const sq = sqOf(index);
			if (!panel || !sq) return;

			openIndex = index;
			panel.classList.add("is-open");
			sq.classList.add("is-open");
			sq.setAttribute("aria-expanded", "true");
			paint();

			// 涟漪：先摘类再挂回去，重复点同一块也能重放
			sq.classList.remove("is-bursting");
			void sq.offsetWidth;
			sq.classList.add("is-bursting");

			// 绽开的同时把附近水母惊散。事件派发在 hero 上、水母层自己监听，
			// 两个组件不用互相 import（面板中心 = 方框中心）。
			const rect = hero.getBoundingClientRect();
			hero.dispatchEvent(
				new CustomEvent("lumen-burst", {
					detail: {
						x: rect.left + (rect.width * Number.parseFloat(sq.style.left)) / 100 + 50,
						y: rect.top + (rect.height * Number.parseFloat(sq.style.top)) / 100 + 50,
					},
				}),
			);

			// 只有键盘触发才把焦点移进面板；鼠标点击移焦点会多出一个焦点环
			if (fromKeyboard) panel.querySelector<HTMLButtonElement>("[data-lumen-close]")?.focus();
		};

		for (const sq of sqs) {
			const index = indexOf(sq);
			if (!index) continue;
			sq.addEventListener("click", (event) => {
				openPanel(index, event.detail === 0);
			});
			sq.addEventListener("pointerenter", () => {
				hoverIndex = index;
				paint();
			});
			sq.addEventListener("pointerleave", () => {
				if (hoverIndex === index) hoverIndex = null;
				paint();
			});
		}

		// 标签只做悬停联动，不绑点击 —— 保持「方框才是开关」这一个语义
		for (const label of labels) {
			const index = indexOf(label);
			if (!index) continue;
			label.addEventListener("pointerenter", () => {
				hoverIndex = index;
				paint();
			});
			label.addEventListener("pointerleave", () => {
				if (hoverIndex === index) hoverIndex = null;
				paint();
			});
		}

		// 关闭格：面板左上角那 100×100 正好压在方框原位之上（z-index 20），
		// 所以「再点原位关掉」实际命中的是它，而不是下面那个方框 ——
		// 方框自带的 toggle 只是这道压盖失效时的兜底。
		for (const panel of panels) {
			panel
				.querySelector<HTMLElement>("[data-lumen-close]")
				?.addEventListener("click", () => closePanel(true));
		}

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") closePanel(true);
		});

		// 点面板外部空白收起（点在面板里、或点在方框上都不算外部）
		hero.addEventListener("pointerdown", (event) => {
			if (!openIndex) return;
			const target = event.target as Element | null;
			if (target?.closest(".lumen-node-panel, .lumen-node-sq")) return;
			closePanel(false);
		});

		// 入场动画跑完才允许交互：opacity: 0 不挡命中测试，不加这道闸就会
		// 「看不见却能被点亮、被点开」。reduced-motion 下没有动画，直接放行。
		const unlock = (el: HTMLElement) => el.classList.add("is-ready");

		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			for (const el of [...sqs, ...labels]) unlock(el);
		} else {
			for (const sq of sqs) {
				sq.addEventListener(
					"animationend",
					() => {
						// 摘掉入场动画的 forwards 填充，否则它会一直压着 hover 的 transform
						sq.classList.remove("anim-scale-in");
						sq.classList.add("is-landed");
						unlock(sq);
					},
					{ once: true },
				);
			}
			for (const label of labels) {
				const inner = label.firstElementChild as HTMLElement | null;
				inner?.addEventListener("animationend", () => unlock(label), { once: true });
			}
		}

		// 交互只在 lg+ 开放（窄屏放不下面板）。pointer-events 管住鼠标，
		// disabled 管住 Tab，两者都要。
		const syncInteractive = () => {
			const on = lgQuery.matches;
			if (!on) closePanel(false);
			for (const sq of sqs) sq.disabled = !on;
		};
		syncInteractive();
		lgQuery.addEventListener("change", syncInteractive);

		// ---- 页内所有可点击元素：平滑滚动到目标小节 ----
		// 首屏的 4 个导航项、CTA、信息卡链接、滚动提示，以及正文底部的「回到首屏」，
		// 统一走 data-scroll-to（值是 CSS 选择器）。
		const prefersReduced = () =>
			window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		const scrollToTarget = (selector: string) => {
			const target = document.querySelector(selector);
			if (!target) return;
			// 先把叠层收掉再滚：移动端菜单、以及首屏的节点面板
			setOpen(false);
			closePanel(false);
			target.scrollIntoView({
				behavior: prefersReduced() ? "auto" : "smooth",
				block: "start",
			});
		};

		document.querySelectorAll<HTMLElement>("[data-scroll-to]").forEach((el) => {
			el.addEventListener("click", (event) => {
				const selector = el.dataset.scrollTo;
				if (!selector) return;
				event.preventDefault();
				scrollToTarget(selector);
			});
		});

		// ---- 正文小节入场 ----
		// 默认可见；只有脚本跑起来（.lumen-js）才会先隐藏，避免无 JS 时白屏。
		document.documentElement.classList.add("lumen-js");
		const reveals = document.querySelectorAll("#lumen-article .lumen-reveal");

		if ("IntersectionObserver" in window) {
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					}
				},
				{ rootMargin: "0px 0px -12% 0px", threshold: 0.05 },
			);
			reveals.forEach((el) => observer.observe(el));
		} else {
			reveals.forEach((el) => el.classList.add("is-visible"));
		}
	}
</script>
